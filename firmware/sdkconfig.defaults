CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3-WROOM-1U-N8R2: 8MB flash / 2MB Quad PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# PSRAM 無しの -N8 を実装した場合でも起動できるように
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# GPIO19/20 は TinyUSB (USB-OTG) が使うので、コンソールは UART0 (GPIO43/44 テストパッド)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# USB CDC-NCM (Linux cdc_ncm / macOS / Windows 11 UsbNcm.sys で標準認識)
CONFIG_TINYUSB_NET_MODE_NCM=y
# TinyUSB は単一コアで初期化・実行する必要がある
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
CONFIG_TINYUSB_INIT_IN_DEFAULT_TASK=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Example Corp."
CONFIG_TINYUSB_DESC_PRODUCT_STRING="USB-LAN Adapter"

# Wi-Fi スループット向け (初期値。実測して調整)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_TX_BA_WIN=32
